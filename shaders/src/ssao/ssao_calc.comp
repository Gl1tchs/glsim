#version 450

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0) uniform SSAOData {
    mat4 viewproj;
    float radius;
    float bias;
    float _padding[2];
    vec3 samples[64];
} u_data;

layout(set = 0, binding = 1) uniform sampler2D g_position;
layout(set = 0, binding = 2) uniform sampler2D g_normal;
layout(set = 0, binding = 3, r8) coherent uniform image2D g_ssao;

void main() {
    const ivec2 texel_coord = ivec2(gl_GlobalInvocationID.xy);
    const ivec2 size = imageSize(g_ssao);

    if (texel_coord.x >= size.x || texel_coord.y >= size.y) return;

    vec2 uv = (vec2(texel_coord) + 0.5) / vec2(size);

    vec3 frag_pos = texture(g_position, uv).xyz;
    vec3 normal = normalize(texture(g_normal, uv).xyz);

    // Use a basic noise pattern to rotate kernel (avoids banding)
    // A simple hash function works if you don't want a noise texture yet
    float random = fract(sin(dot(uv, vec2(12.9898, 78.233))) * 43758.5453);
    vec3 random_vec = normalize(vec3(random * 2.0 - 1.0, fract(random * 10.0) * 2.0 - 1.0, 0.0));

    vec3 tangent = normalize(random_vec - normal * dot(random_vec, normal));
    vec3 bitangent = cross(normal, tangent);
    mat3 TBN = mat3(tangent, bitangent, normal);

    float occlusion = 0.0;
    for (int i = 0; i < 32; ++i) {
        vec3 sample_pos = TBN * u_data.samples[i];
        sample_pos = frag_pos + sample_pos * u_data.radius;

        vec4 offset = u_data.viewproj * vec4(sample_pos, 1.0);
        offset.xyz /= offset.w;
        offset.xyz = offset.xyz * 0.5 + 0.5;

        // Sample position from G-Buffer
        float sample_depth = texture(g_position, offset.xy).z;

        // Range check prevents "bleeding" onto far objects
        float range_check = smoothstep(0.0, 1.0, u_data.radius / abs(frag_pos.z - sample_depth));
        occlusion += (sample_depth >= sample_pos.z + u_data.bias ? 1.0 : 0.0) * range_check;
    }

    occlusion = 1.0 - (occlusion / 64.0);

    imageStore(g_ssao, texel_coord, vec4(occlusion, 0, 0, 1));
}
