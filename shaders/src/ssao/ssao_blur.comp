#version 450

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0) uniform sampler2D g_position;
layout(set = 0, binding = 1, r8) coherent uniform image2D g_ssao;

void main() {
    ivec2 texel_coord = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(g_ssao);
    if (texel_coord.x >= size.x || texel_coord.y >= size.y) return;

    vec2 uv = (vec2(texel_coord) + 0.5) / vec2(size);
    float center_depth = texture(g_position, uv).z;

    vec4 result = vec4(0.0);
    float total_weight = 0.0;

    // 4x4 or 2x2 blur kernel
    for (int x = -2; x <= 2; ++x) {
        for (int y = -2; y <= 2; ++y) {
            ivec2 offset = ivec2(x, y);
            ivec2 neighbor_coord = texel_coord + offset;
            vec2 neighbor_uv = (vec2(neighbor_coord) + 0.5) / vec2(size);

            float neighbor_depth = texture(g_position, neighbor_uv).z;

            // Bilateral weight: only blur if depths are close
            float weight = 1.0 / (1.0 + abs(center_depth - neighbor_depth) * 100.0);

            result += imageLoad(g_ssao, neighbor_coord) * weight;
            total_weight += weight;
        }
    }

    imageStore(g_ssao, texel_coord, result / total_weight);
}
